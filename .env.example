# Токен бота, полученный от @BotFather
BOT_TOKEN=

# ID группового чата (отрицательное число, например -1001234567890)
GROUP_CHAT_ID=

# Firebase / Firestore
FIREBASE_PROJECT_ID=
# Полное содержимое JSON-ключа сервисного аккаунта Firebase, в одну строку
FIREBASE_SERVICE_ACCOUNT_JSON=

# Таймзона по умолчанию для /set_schedule и /set_reminder_time, если её не указали (необязательно, иначе UTC)
DEFAULT_TIMEZONE=Europe/Moscow

# Нужен только если хостинг требует привязку порта даже для background worker
PORT=
