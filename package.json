{
  "name": "ride-bot",
  "version": "1.20.1",
  "description": "Telegram bot for group ride destination planning",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src",
    "test": "node --import tsx --test src/*/*.test.ts",
    "test:integration": "npx --yes firebase-tools@14 emulators:exec --only firestore --project demo-ride-bot 'node --import tsx --import ./src/integration/setup.ts --test --test-concurrency=1 src/integration/*.itest.ts'",
    "restore": "tsx src/scripts/restore.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "dotenv": "^18.0.4",
    "firebase-admin": "^14.5.0",
    "grammy": "^1.44.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.1",
    "oxlint": "^1.16.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
